# ─── X (Twitter) Developer App ───────────────────────────────────────────────
# Register at https://developer.x.com → create a project → create an app
# App type: "Web App, Automated App or Bot"
# Enable: OAuth 2.0 with PKCE  (Type of App: Public client)
# Callback URL: https://gitmuskarena.vercel.app   (add localhost:5173 for dev)
# Website URL:  https://gitmuskarena.vercel.app

# Client ID (safe to commit — it is public, not a secret)
VITE_X_CLIENT_ID=your_client_id_here

# OAuth redirect URI (must exactly match X App settings)
VITE_REDIRECT_URI=https://gitmuskarena.vercel.app

# Optional: custom token exchange proxy URL (defaults to /.netlify/functions/token-exchange)
# VITE_TOKEN_PROXY_URL=https://your-worker.workers.dev/token-exchange

# ─── Supabase (client-side — use ANON key, NOT service key) ──────────────────
# These are safe to expose in the browser
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Netlify / Vercel server-side only (NOT prefixed with VITE_) ──────────────
# Set these in the Netlify/Vercel dashboard under Environment Variables
# X_CLIENT_ID=your_client_id_here
# X_CLIENT_SECRET=your_client_secret_here   # only needed for confidential client
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_service_role_key_here  # server-side only, never expose
