{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/img-proxy/:path*",
      "destination": "https://pbs.twimg.com/:path*"
    },
    {
      "source": "/unavatar/:path*",
      "destination": "https://unavatar.io/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/season-reset",
      "schedule": "0 0 * * *"
    }
  ]
}
